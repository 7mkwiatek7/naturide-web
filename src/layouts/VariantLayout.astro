---
import { Image } from 'astro:assets';
import { t, type Lang, type UIKey } from '../i18n/ui';
import photo from '../../public/images/naturide-background.jpg';
import heroPhoto from '../assets/hero/naturide-stats.png';
import plannerPhoto from '../assets/planner/naturide-stats-night.png';
import navigationScreen from '../assets/screens/concept-navigation.png';
import routeProfileScreen from '../assets/screens/concept-route-profile.png';

interface Props { lang: Lang; variant?: boolean }
const { lang, variant = false } = Astro.props;
const copyPrefix = variant ? 'variant' : 'concept';
const text = (key: string) => t(lang, `${copyPrefix}.${key}` as UIKey);
const secondaryText = text('secondary');
const heroImage = variant ? heroPhoto : photo;
const languageUrl = lang === 'pl' ? '/en/' : '/';
const privacyUrl = lang === 'pl' ? '/polityka-prywatnosci/' : '/en/privacy-policy/';
const removeDataUrl = lang === 'pl' ? '/usun-dane/' : '/en/remove-data/';
const facebookUrl = 'https://www.facebook.com/Naturideapp/';
const year = new Date().getFullYear();
const benefits = [
  { number: '01', title: 'offline.title', desc: 'offline.desc' },
  { number: '02', title: 'loop.title', desc: 'loop.desc' },
  { number: '03', title: 'screen.title', desc: 'screen.desc' },
] as const;
const detailKeys = variant
  ? ['detail.gpx', 'detail.night', 'detail.record', 'detail.privacy']
  : ['detail.gpx', 'detail.night', 'detail.record'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={t(lang, 'meta.description')} />
    <title>{t(lang, 'meta.title')}</title>
    <link rel="icon" href="/images/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">{text('skip')}</a>
    <header class="wrap header">
      <a class="brand" href="#main" aria-label="Naturide">
        <img src="/images/logo.png" width="38" height="38" alt="" />
        Naturide<span class="brand-dot" aria-hidden="true">.</span>
      </a>
      <nav aria-label={text('nav.app')}>
        <a class="nav-section" href="#why">{text('nav.why')}</a>
        <a class="nav-section" href="#app">{text('nav.app')}</a>
        {variant && <button id="planner-trigger" class="nav-section planner-trigger" type="button" aria-haspopup="dialog" aria-controls="planner-dialog">{text('planner.link')}</button>}
        <a class="language" href={languageUrl} aria-label={text('language')} lang={lang === 'pl' ? 'en' : 'pl'}>{lang === 'pl' ? 'EN' : 'PL'}</a>
        <a class="button button-small" href="#join">{text('cta')} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    {variant && (
      <dialog id="planner-dialog" class="planner-dialog" aria-labelledby="planner-heading">
        <div class="planner-card">
          <button id="planner-close" class="planner-close" type="button" aria-label={text('planner.close')}><span aria-hidden="true">×</span></button>
          <div class="planner-visual">
            <Image src={plannerPhoto} alt={text('planner.imageAlt')} widths={[480, 760]} sizes="(max-width: 760px) 80vw, 30vw" format="webp" quality={80} loading="lazy" decoding="async" />
          </div>
          <div class="planner-copy">
            <p class="eyebrow">{text('planner.eyebrow')}</p>
            <h2 id="planner-heading">{text('planner.title')}</h2>
            <p>{text('planner.desc')}</p>
            <p class="planner-note">
              {text('planner.note')}
              <a class="planner-cta" href="#join">{text('planner.cta')}</a>
            </p>
          </div>
        </div>
      </dialog>
    )}

    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow"><span class="little-line"></span>{text('eyebrow')}</p>
          <h1 id="hero-heading">{text('hero.first')} <span>{text('hero.second')}</span></h1>
          <p class="hero-desc">{text('hero.desc')}</p>
          <div class="hero-actions">
            <a class="button" href="#join">{text('cta')} <span aria-hidden="true">↗</span></a>
            {secondaryText && <a class="text-link" href="#app">{secondaryText} <span aria-hidden="true">↓</span></a>}
          </div>
          <p class="stage"><span class="status-dot" aria-hidden="true"></span>{text('stage')}</p>
        </div>
        <div class={variant ? 'hero-visual hero-visual-variant' : 'hero-visual'}>
          <figure class={variant ? 'landscape landscape-new' : 'landscape'}>
            <Image src={heroImage} alt={text('photo.alt')} widths={[480, 960]} sizes="(max-width: 760px) 90vw, 46vw" format="webp" quality={85} loading="eager" />
            <figcaption>{text('photo.caption')}</figcaption>
          </figure>
          <figure class="hero-phone">
            <a class="phone" href={navigationScreen.src} target="_blank" rel="noopener noreferrer" aria-label={text('screen.open')}>
              <Image src={navigationScreen} alt={text('screen.alt')} widths={[320, 648]} sizes="196px" format="webp" quality={85} loading="eager" />
            </a>
            <figcaption>{text('screen.caption')}</figcaption>
          </figure>
          <span class="photo-index" aria-hidden="true">01 / NATURIDE</span>
        </div>
      </section>

      <div class="wrap promise-strip">
        <div>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 9 8-4 8 4 8-4v21l-8 3-8-4-8 4V9Zm8-4v20m8-16v20"/><path d="m8 17 5-3 5 4 6-5" stroke-dasharray="2 2"/></svg>
          <strong>{text('strip.offline')}</strong>
          <p>{text('strip.offline.desc')}</p>
        </div>
        <div>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M24 8a11 11 0 1 0 3 12M24 3v6h-6"/><circle cx="16" cy="16" r="3"/></svg>
          <strong>{text('strip.loop')}</strong>
          <p>{text('strip.loop.desc')}</p>
        </div>
        <div>
          {variant && <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="6" y="13" width="20" height="14" rx="3"/><path d="M10 13v-2a6 6 0 0 1 12 0v2"/></svg>}
          {!variant && <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="9" width="24" height="14" rx="3"/><path d="M29 13v6M7 13v6m4-6v6m4-6v6"/></svg>}
          <strong>{text('strip.screen')}</strong>
          <p>{text('strip.screen.desc')}</p>
        </div>
      </div>

      <section class="wrap benefits" id="why" aria-labelledby="benefits-heading">
        <div class="benefits-intro">
          <p class="eyebrow">{text('benefits.eyebrow')}</p>
          <h2 id="benefits-heading" class={variant ? 'benefits-title-long' : undefined}>{text('benefits.title')}</h2>
          <p>{text('benefits.desc')}</p>
          <svg class="route-drawing" viewBox="0 0 320 150" fill="none" aria-hidden="true">
            <path d="M1 111C51 87 36 29 104 40s28 86 104 72 35-82 108-96M8 139C89 105 28 3 119 17s14 114 112 120 29-82 88-83" stroke="#dce2d6"/>
            <path d="M28 114c70 0 16-67 82-53s29 69 91 39 45-61 83-51" stroke="#71856a" stroke-width="2" stroke-dasharray="5 6"/>
            <circle cx="28" cy="114" r="7" fill="#234e3b"/><circle cx="284" cy="49" r="7" fill="#f7f7ef" stroke="#234e3b" stroke-width="3"/>
          </svg>
        </div>
        <div class="benefit-list">
          {benefits.map((benefit) => (
            <article>
              <span class="number">{benefit.number}</span>
              <div>
                <div class="benefit-heading">
                  {variant && benefit.number === '03' && <svg class="benefit-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="9" width="24" height="14" rx="3"/><path d="M29 13v6M7 13v6m4-6v6m4-6v6"/></svg>}
                  <h3>{text(benefit.title)}</h3>
                </div>
                <p>{text(benefit.desc)}</p>
                {benefit.number === '02' && <small>{text('loop.note')}</small>}
                {variant && benefit.number === '03' && <small>{text('screen.note')}</small>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="app-section" id="app" aria-labelledby="app-heading">
        <div class="wrap app-grid">
          <figure class="app-visual">
            <div class="contour contour-one" aria-hidden="true"></div>
            <div class="contour contour-two" aria-hidden="true"></div>
            <div class="contour contour-three" aria-hidden="true"></div>
            <a class="phone navigation-phone" href={routeProfileScreen.src} target="_blank" rel="noopener noreferrer" aria-label={text('detail.screenOpen')}>
              <Image src={routeProfileScreen} alt={text('detail.screenAlt')} widths={[480, 652]} sizes="270px" format="webp" quality={85} loading="lazy" decoding="async" />
            </a>
            <figcaption>{text('detail.note')}</figcaption>
          </figure>
          <div class="app-copy">
            <p class="eyebrow">{text('detail.eyebrow')}</p>
            <h2 id="app-heading">{text('detail.title')}</h2>
            <p>{text('detail.desc')}</p>
            <ul>
              {detailKeys.map((key) => (
                <li><span aria-hidden="true">↗</span>{text(key)}</li>
              ))}
            </ul>
            <a class="text-link" href="#join">{text('cta')} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="wrap join" id="join" aria-labelledby="join-heading">
        <div>
          <p class="eyebrow">{text('join.eyebrow')}</p>
          <h2 id="join-heading">{text('join.title')}</h2>
          <p class="join-desc">{text('join.desc')}</p>
          {variant && <p class="join-desc">{text('join.desc2')}</p>}
        </div>
        <div id={variant ? 'notify-form-content' : undefined}>
          <form id={variant ? 'notify-form' : 'preview-form'}>
            {variant && (
              <>
                <div class="honeypot" aria-hidden="true">
                  <label>
                    {t(lang, 'comingsoon.honeypot')}
                    <input name="bot-field" tabindex="-1" autocomplete="off" />
                  </label>
                </div>
                <input type="hidden" name="lang" value={lang} />
              </>
            )}
            <label for={variant ? 'notify-email' : 'preview-email'}>{text('join.email')}</label>
            <div class="email-row">
              <input
                id={variant ? 'notify-email' : 'preview-email'}
                type="email"
                name={variant ? 'email' : undefined}
                autocomplete={variant ? 'email' : 'off'}
                placeholder={text('join.placeholder')}
                required
                aria-describedby={variant ? 'notify-consent notify-note' : 'form-note'}
              />
              <button
                class="button"
                type="submit"
                data-loading-text={variant ? t(lang, 'comingsoon.loading') : undefined}
                disabled
              >
                {text('cta')} <span aria-hidden="true">↗</span>
              </button>
            </div>
            <label class="consent" id={variant ? 'notify-consent' : undefined}>
              <input
                type="checkbox"
                name={variant ? 'consent' : undefined}
                value={variant ? 'accepted' : undefined}
                required
              />
              <span>{text('join.consent')} <a href={privacyUrl}>{t(lang, 'comingsoon.privacyPolicy')}</a>.</span>
            </label>
            <p class="form-note" id={variant ? 'notify-note' : 'form-note'}>
              {text('join.note')}
              {variant && (
                <>
                  {' · '}
                  <a href={removeDataUrl}>{t(lang, 'comingsoon.removeHint')}</a>
                </>
              )}
            </p>
            {variant && (
              <p id="notify-error" class="form-feedback form-error" role="alert" hidden>
                {t(lang, 'comingsoon.error')}
              </p>
            )}
            {!variant && <p class="form-feedback" role="status" hidden>{text('join.feedback')}</p>}
          </form>
        </div>
        {variant && (
          <div id="notify-success" class="form-feedback" role="status" tabindex="-1" hidden>
            <p>{t(lang, 'comingsoon.success')}</p>
            <p id="notify-mail-already" hidden>{t(lang, 'comingsoon.alreadySaved')}</p>
            <p id="notify-mail-ok" hidden>{t(lang, 'comingsoon.mailSent')}</p>
            <p id="notify-mail-fail" hidden>{t(lang, 'comingsoon.mailNotSent')}</p>
            <p id="notify-retry-wait" class="retry-wait" role="status" hidden>{t(lang, 'comingsoon.retryWait')}</p>
            <p id="notify-retry-error" class="form-error" role="alert" hidden>{t(lang, 'comingsoon.retryError')}</p>
            <button
              id="notify-retry"
              class="button"
              type="button"
              data-loading-text={t(lang, 'comingsoon.loading')}
              hidden
            >
              {t(lang, 'comingsoon.retry')}
            </button>
          </div>
        )}
      </section>
    </main>
    <footer id="contact" class="full-footer">
      <div class="wrap footer-grid">
        <div class="footer-intro">
          <a class="brand" href="#main" aria-label="Naturide">
            <img src="/images/logo.png" width="40" height="40" alt="" />
            Naturide<span class="brand-dot" aria-hidden="true">.</span>
          </a>
          <p>{text('footer')}</p>
        </div>
        <div>
          <h2 class="footer-heading">{t(lang, 'contact.title')}</h2>
          <ul class="footer-list">
            <li>
              <span>{t(lang, 'contact.email')}</span>
              <a href="mailto:mkwiatek.dev@gmail.com">mkwiatek.dev@gmail.com</a>
            </li>
            <li>
              <span>{t(lang, 'contact.facebook')}</span>
              <a href={facebookUrl} target="_blank" rel="noopener noreferrer">facebook.com/Naturideapp</a>
            </li>
          </ul>
        </div>
        <div>
          <h2 class="footer-heading">Naturide</h2>
          <ul class="footer-list footer-links">
            <li><a href={privacyUrl}>{t(lang, 'footer.privacy')}</a></li>
            <li><a href={removeDataUrl}>{t(lang, 'footer.removeData')}</a></li>
            <li><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>{t(lang, 'footer.copyright').replace('{year}', String(year))}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const liveForm = document.querySelector<HTMLFormElement>('#notify-form');
  const liveSubmit = liveForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const liveFormContent = document.querySelector<HTMLDivElement>('#notify-form-content');
  const liveSuccess = document.querySelector<HTMLDivElement>('#notify-success');
  const liveError = document.querySelector<HTMLParagraphElement>('#notify-error');
  const liveMailAlready = document.querySelector<HTMLParagraphElement>('#notify-mail-already');
  const liveMailOk = document.querySelector<HTMLParagraphElement>('#notify-mail-ok');
  const liveMailFail = document.querySelector<HTMLParagraphElement>('#notify-mail-fail');
  const liveRetry = document.querySelector<HTMLButtonElement>('#notify-retry');
  const liveRetryWait = document.querySelector<HTMLParagraphElement>('#notify-retry-wait');
  const liveRetryError = document.querySelector<HTMLParagraphElement>('#notify-retry-error');

  interface NotifyResponse {
    ok: true;
    already?: boolean;
    emailSent?: boolean;
    canRetry?: boolean;
    retryAfterSeconds?: number;
  }

  function isNotifyResponse(value: unknown): value is NotifyResponse {
    if (typeof value !== 'object' || value === null || !('ok' in value) || value.ok !== true) return false;
    if ('already' in value && typeof value.already !== 'boolean') return false;
    if ('emailSent' in value && typeof value.emailSent !== 'boolean') return false;
    if ('canRetry' in value && typeof value.canRetry !== 'boolean') return false;
    if ('retryAfterSeconds' in value && typeof value.retryAfterSeconds !== 'number') return false;
    return true;
  }

  if (
    liveForm &&
    liveSubmit &&
    liveFormContent &&
    liveSuccess &&
    liveError &&
    liveMailAlready &&
    liveMailOk &&
    liveMailFail &&
    liveRetry &&
    liveRetryWait &&
    liveRetryError
  ) {
    const sendApplication = async (retry: boolean) => {
      const button = retry ? liveRetry : liveSubmit;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = button.getAttribute('data-loading-text') || '';
      liveError.hidden = true;
      liveRetryError.hidden = true;
      liveRetryWait.hidden = true;

      try {
        const body = new URLSearchParams();
        new FormData(liveForm).forEach((value, key) => {
          if (typeof value === 'string') body.append(key, value);
        });
        if (retry) body.set('retry', '1');
        const response = await fetch('/api/notify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        const payload: unknown = await response.json().catch(() => null);
        if (!response.ok || !isNotifyResponse(payload)) {
          throw new Error('notify_failed');
        }

        liveFormContent.hidden = true;
        liveSuccess.hidden = false;
        liveSuccess.focus();
        liveMailAlready.hidden = payload.already !== true || retry;
        liveMailOk.hidden = payload.emailSent !== true || (payload.already === true && !retry);
        liveMailFail.hidden = payload.emailSent !== false;

        const canRetry = payload.canRetry === true;
        const retryAfterSeconds = canRetry ? Math.max(0, payload.retryAfterSeconds || 0) : 0;
        liveRetry.hidden = !canRetry;
        liveRetry.disabled = retryAfterSeconds > 0;
        liveRetryWait.hidden = retryAfterSeconds === 0;
        if (retryAfterSeconds > 0) {
          window.setTimeout(() => {
            liveRetry.disabled = false;
            liveRetryWait.hidden = true;
          }, retryAfterSeconds * 1000);
        }
      } catch {
        if (retry) {
          liveRetryError.hidden = false;
          liveRetry.disabled = false;
        } else {
          liveError.hidden = false;
          liveSubmit.disabled = false;
        }
      } finally {
        button.textContent = originalText;
      }
    };

    liveForm.addEventListener('submit', (event) => {
      event.preventDefault();
      void sendApplication(false);
    });
    liveRetry.addEventListener('click', () => void sendApplication(true));
    liveSubmit.disabled = false;
  }

  const form = document.querySelector<HTMLFormElement>('#preview-form');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const feedback = form?.querySelector<HTMLParagraphElement>('[role="status"]');
  if (form && submit && feedback) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      feedback.hidden = false;
      form.reset();
    });
    // Enable only after the local-only handler is attached. Inputs have no names.
    submit.disabled = false;
  }

  const plannerTrigger = document.querySelector<HTMLButtonElement>('#planner-trigger');
  const plannerDialog = document.querySelector<HTMLDialogElement>('#planner-dialog');
  const plannerClose = document.querySelector<HTMLButtonElement>('#planner-close');
  const plannerCta = document.querySelector<HTMLAnchorElement>('.planner-cta');
  if (plannerTrigger && plannerDialog && plannerClose) {
    plannerTrigger.addEventListener('click', () => plannerDialog.showModal());
    plannerClose.addEventListener('click', () => plannerDialog.close());
    plannerCta?.addEventListener('click', () => plannerDialog.close());
    plannerDialog.addEventListener('click', (event) => {
      if (event.target === plannerDialog) plannerDialog.close();
    });
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 28px; background: #f7f7ef; }
  :global(body) { margin: 0; color: #203d30; font-family: 'Segoe UI', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(astro-dev-toolbar) { display: none; }
  :global(*) { box-sizing: border-box; }
  :global(::selection) { background: #d8e4b5; color: #203d30; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button), :global(input) { font: inherit; }
  :global(a:focus-visible), :global(button:focus-visible), :global(input:focus-visible) { outline: 3px solid #84964b; outline-offset: 5px; }
  :global(figure), :global(p), :global(h1), :global(h2), :global(h3) { margin: 0; }
  :global(img) { display: block; max-width: 100%; height: auto; }
  .wrap { width: min(1180px, calc(100% - 96px)); margin-inline: auto; }
  .preview-bar { display: flex; justify-content: center; gap: 26px; padding: 10px 20px; background: #e9eddf; color: #4f604d; font-size: 12px; letter-spacing: .02em; }
  .preview-bar a { text-decoration: underline; text-underline-offset: 3px; }
  .skip { position: absolute; top: -100px; left: 20px; z-index: 10; padding: 12px; background: white; }
  .skip:focus { top: 10px; }
  .header { display: flex; align-items: center; justify-content: space-between; padding-block: 25px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 28px; font-weight: 750; letter-spacing: -1.3px; }
  .brand img { border-radius: 11px; }
  .brand-dot { color: #80934f; margin-left: -8px; }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 600; }
  .nav-section { font-size: 16px; }
  .planner-trigger { border: 0; padding: 0; background: transparent; color: inherit; cursor: pointer; }
  nav > .nav-section:hover { text-decoration: underline; text-underline-offset: 5px; }
  nav > a:not(.button):hover { text-decoration: underline; text-underline-offset: 5px; }
  .language { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 24px; min-height: 53px; border: 1px solid #264c38; padding: 15px 24px; border-radius: 7px; background: #264c38; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: background .18s; white-space: nowrap; }
  .button[hidden] { display: none; }
  .button:hover { background: #163725; }
  .button:disabled { opacity: .6; cursor: not-allowed; }
  .button span { font-size: 19px; line-height: 1; }
  .button-small { min-height: 44px; padding: 10px 18px; font-size: 13px; gap: 19px; }
  .planner-dialog { width: min(1060px, calc(100% - 32px)); max-width: none; padding: 0; border: 0; border-radius: 16px; background: #f7f7ef; color: #203d30; box-shadow: 0 24px 80px rgb(13 30 20 / .3); }
  .planner-dialog::backdrop { background: rgb(13 30 20 / .58); backdrop-filter: blur(3px); }
  .planner-card { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; overflow: hidden; }
  .planner-visual { display: flex; min-height: 420px; align-items: center; justify-content: center; overflow: hidden; padding: 28px 28px 28px 40px; background: #f7f7ef; }
  .planner-visual img { width: 100%; height: auto; max-height: none; object-fit: contain; object-position: center; filter: drop-shadow(0 0 8px rgb(32 61 48 / .99)); }
  .planner-copy { display: flex; flex-direction: column; justify-content: center; padding: 48px 44px; }
  .planner-copy h2 { padding-right: 18px; }
