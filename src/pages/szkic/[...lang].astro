---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { t, type Lang } from '../../i18n/ui';
import photo from '../../../public/images/naturide-background.jpg';

// Never include the concept in the production site, even if these files are committed.
export const getStaticPaths = (() => import.meta.env.DEV ? [
  { params: { lang: undefined }, props: { lang: 'pl' } },
  { params: { lang: 'en' }, props: { lang: 'en' } },
] : []) satisfies GetStaticPaths;

interface Props { lang: Lang }
const { lang } = Astro.props;
const currentUrl = lang === 'pl' ? '/' : '/en/';
const privacyUrl = lang === 'pl' ? '/polityka-prywatnosci/' : '/en/privacy-policy/';
const benefits = [
  { number: '01', title: 'concept.offline.title', desc: 'concept.offline.desc' },
  { number: '02', title: 'concept.loop.title', desc: 'concept.loop.desc' },
  { number: '03', title: 'concept.screen.title', desc: 'concept.screen.desc' },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>{t(lang, 'concept.title')}</title>
    <link rel="icon" href="/images/logo.png" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'concept.skip')}</a>
    <div class="preview-bar">
      <span>{t(lang, 'concept.preview')}</span>
      <a href={currentUrl}>{t(lang, 'concept.current')} <span aria-hidden="true">↗</span></a>
    </div>
    <header class="wrap header">
      <a class="brand" href="#main" aria-label="Naturide">
        <img src="/images/logo.png" width="38" height="38" alt="" />
        Naturide<span class="brand-dot" aria-hidden="true">.</span>
      </a>
      <nav aria-label={t(lang, 'concept.nav.app')}>
        <a class="nav-section" href="#why">{t(lang, 'concept.nav.why')}</a>
        <a class="nav-section" href="#app">{t(lang, 'concept.nav.app')}</a>
        <a class="language" href={lang === 'pl' ? '/szkic/en/' : '/szkic/'} aria-label={t(lang, 'concept.language')} lang={lang === 'pl' ? 'en' : 'pl'}>{lang === 'pl' ? 'EN' : 'PL'}</a>
        <a class="button button-small" href="#join">{t(lang, 'concept.cta')} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="wrap hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <p class="eyebrow"><span class="little-line"></span>{t(lang, 'concept.eyebrow')}</p>
          <h1 id="hero-heading">{t(lang, 'concept.hero.first')} <span>{t(lang, 'concept.hero.second')}</span></h1>
          <p class="hero-desc">{t(lang, 'concept.hero.desc')}</p>
          <div class="hero-actions">
            <a class="button" href="#join">{t(lang, 'concept.cta')} <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#app">{t(lang, 'concept.secondary')} <span aria-hidden="true">↓</span></a>
          </div>
          <p class="stage"><span class="status-dot" aria-hidden="true"></span>{t(lang, 'concept.stage')}</p>
        </div>
        <div class="hero-visual">
          <figure class="landscape">
            <Image src={photo} alt={t(lang, 'concept.photo.alt')} widths={[480, 960]} sizes="(max-width: 760px) 90vw, 46vw" format="webp" quality={85} loading="eager" />
            <figcaption>{t(lang, 'concept.photo.caption')}</figcaption>
          </figure>
          <figure class="hero-phone">
            <a class="phone" href="/src/assets/screens/concept-navigation.png" target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'concept.screen.open')}>
              <img src="/src/assets/screens/concept-navigation.png" alt={t(lang, 'concept.screen.alt')} width="648" height="1439" loading="eager" decoding="async" />
            </a>
            <figcaption>{t(lang, 'concept.screen.caption')}</figcaption>
          </figure>
          <span class="photo-index" aria-hidden="true">01 / NATURIDE</span>
        </div>
      </section>

      <div class="wrap promise-strip">
        <div>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 9 8-4 8 4 8-4v21l-8 3-8-4-8 4V9Zm8-4v20m8-16v20"/><path d="m8 17 5-3 5 4 6-5" stroke-dasharray="2 2"/></svg>
          <p><strong>{t(lang, 'concept.strip.offline')}</strong><span>{t(lang, 'concept.strip.offline.desc')}</span></p>
        </div>
        <div>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M24 8a11 11 0 1 0 3 12M24 3v6h-6"/><circle cx="16" cy="16" r="3"/></svg>
          <p><strong>{t(lang, 'concept.strip.loop')}</strong><span>{t(lang, 'concept.strip.loop.desc')}</span></p>
        </div>
        <div>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="9" width="24" height="14" rx="3"/><path d="M29 13v6M7 13v6m4-6v6m4-6v6"/></svg>
          <p><strong>{t(lang, 'concept.strip.screen')}</strong><span>{t(lang, 'concept.strip.screen.desc')}</span></p>
        </div>
      </div>

      <section class="wrap benefits" id="why" aria-labelledby="benefits-heading">
        <div class="benefits-intro">
          <p class="eyebrow">{t(lang, 'concept.benefits.eyebrow')}</p>
          <h2 id="benefits-heading">{t(lang, 'concept.benefits.title')}</h2>
          <p>{t(lang, 'concept.benefits.desc')}</p>
          <svg class="route-drawing" viewBox="0 0 320 150" fill="none" aria-hidden="true">
            <path d="M1 111C51 87 36 29 104 40s28 86 104 72 35-82 108-96M8 139C89 105 28 3 119 17s14 114 112 120 29-82 88-83" stroke="#dce2d6"/>
            <path d="M28 114c70 0 16-67 82-53s29 69 91 39 45-61 83-51" stroke="#71856a" stroke-width="2" stroke-dasharray="5 6"/>
            <circle cx="28" cy="114" r="7" fill="#234e3b"/><circle cx="284" cy="49" r="7" fill="#f7f7ef" stroke="#234e3b" stroke-width="3"/>
          </svg>
        </div>
        <div class="benefit-list">
          {benefits.map((benefit) => (
            <article>
              <span class="number">{benefit.number}</span>
              <div>
                <h3>{t(lang, benefit.title)}</h3>
                <p>{t(lang, benefit.desc)}</p>
                {benefit.number === '02' && <small>{t(lang, 'concept.loop.note')}</small>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="app-section" id="app" aria-labelledby="app-heading">
        <div class="wrap app-grid">
          <figure class="app-visual">
            <div class="contour contour-one" aria-hidden="true"></div>
            <div class="contour contour-two" aria-hidden="true"></div>
            <div class="contour contour-three" aria-hidden="true"></div>
            <a class="phone navigation-phone" href="/src/assets/screens/concept-route-profile.png" target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'concept.detail.screenOpen')}>
              <img src="/src/assets/screens/concept-route-profile.png" alt={t(lang, 'concept.detail.screenAlt')} width="652" height="1432" loading="lazy" decoding="async" />
            </a>
            <figcaption>{t(lang, 'concept.detail.note')}</figcaption>
          </figure>
          <div class="app-copy">
            <p class="eyebrow">{t(lang, 'concept.detail.eyebrow')}</p>
            <h2 id="app-heading">{t(lang, 'concept.detail.title')}</h2>
            <p>{t(lang, 'concept.detail.desc')}</p>
            <ul>
              {(['concept.detail.gpx', 'concept.detail.night', 'concept.detail.record'] as const).map((key) => (
                <li><span aria-hidden="true">↗</span>{t(lang, key)}</li>
              ))}
            </ul>
            <a class="text-link" href="#join">{t(lang, 'concept.cta')} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="wrap join" id="join" aria-labelledby="join-heading">
        <div>
          <p class="eyebrow">{t(lang, 'concept.join.eyebrow')}</p>
          <h2 id="join-heading">{t(lang, 'concept.join.title')}</h2>
          <p class="join-desc">{t(lang, 'concept.join.desc')}</p>
        </div>
        <form id="preview-form">
          <label for="preview-email">{t(lang, 'concept.join.email')}</label>
          <div class="email-row">
            <input id="preview-email" type="email" autocomplete="off" placeholder={t(lang, 'concept.join.placeholder')} required aria-describedby="form-note" />
            <button class="button" type="submit" disabled>{t(lang, 'concept.cta')} <span aria-hidden="true">↗</span></button>
          </div>
          <label class="consent">
            <input type="checkbox" required />
            <span>{t(lang, 'concept.join.consent')} <a href={privacyUrl}>{t(lang, 'comingsoon.privacyPolicy')}</a>.</span>
          </label>
          <p class="form-note" id="form-note">{t(lang, 'concept.join.note')}</p>
          <p class="form-feedback" role="status" hidden>{t(lang, 'concept.join.feedback')}</p>
        </form>
      </section>
    </main>
    <footer class="wrap footer">
      <div><a class="brand" href="#main">Naturide<span class="brand-dot" aria-hidden="true">.</span></a><p>{t(lang, 'concept.footer')}</p></div>
      <p>{t(lang, 'concept.footer.status')}</p>
    </footer>
  </body>
</html>

<script>
  const form = document.querySelector<HTMLFormElement>('#preview-form');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const feedback = form?.querySelector<HTMLParagraphElement>('[role="status"]');
  if (form && submit && feedback) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      feedback.hidden = false;
      form.reset();
    });
    // Enable only after the local-only handler is attached. Inputs have no names.
    submit.disabled = false;
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 28px; background: #f7f7ef; }
  :global(body) { margin: 0; color: #203d30; font-family: 'Segoe UI', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(astro-dev-toolbar) { display: none; }
  :global(*) { box-sizing: border-box; }
  :global(::selection) { background: #d8e4b5; color: #203d30; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(button), :global(input) { font: inherit; }
  :global(a:focus-visible), :global(button:focus-visible), :global(input:focus-visible) { outline: 3px solid #84964b; outline-offset: 5px; }
  :global(figure), :global(p), :global(h1), :global(h2), :global(h3) { margin: 0; }
  :global(img) { display: block; max-width: 100%; height: auto; }
  .wrap { width: min(1180px, calc(100% - 96px)); margin-inline: auto; }
  .preview-bar { display: flex; justify-content: center; gap: 26px; padding: 10px 20px; background: #e9eddf; color: #4f604d; font-size: 12px; letter-spacing: .02em; }
  .preview-bar a { text-decoration: underline; text-underline-offset: 3px; }
  .skip { position: absolute; top: -100px; left: 20px; z-index: 10; padding: 12px; background: white; }
  .skip:focus { top: 10px; }
  .header { display: flex; align-items: center; justify-content: space-between; padding-block: 25px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 28px; font-weight: 750; letter-spacing: -1.3px; }
  .brand img { border-radius: 11px; }
  .brand-dot { color: #80934f; margin-left: -8px; }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 600; }
  .nav-section { font-size: 16px; }
  nav > a:not(.button):hover { text-decoration: underline; text-underline-offset: 5px; }
  .language { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 24px; min-height: 53px; border: 1px solid #264c38; padding: 15px 24px; border-radius: 7px; background: #264c38; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: background .18s; white-space: nowrap; }
  .button:hover { background: #163725; }
  .button:disabled { opacity: .6; cursor: not-allowed; }
  .button span { font-size: 19px; line-height: 1; }
  .button-small { min-height: 44px; padding: 10px 18px; font-size: 13px; gap: 19px; }
  .hero { display: grid; grid-template-columns: 1.08fr 1fr; align-items: center; gap: 54px; padding-top: 25px; padding-bottom: 80px; }
  .hero-copy { padding-bottom: 20px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #5d7054; font-size: 12px; font-weight: 650; letter-spacing: 1.5px; text-transform: uppercase; line-height: 1.8; }
  .little-line { width: 24px; height: 1px; background: currentColor; flex-shrink: 0; }
  h1 { margin-top: 24px; font-size: clamp(46px, 4.9vw, 69px); letter-spacing: -.062em; line-height: 1.08; font-weight: 650; }
  h1 span { display: block; color: #738361; }
  .hero-desc { max-width: 420px; margin-top: 27px; color: #5d655b; font-size: 20px; line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 31px; }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; gap: 15px; font-size: 15px; font-weight: 650; text-decoration: underline; text-underline-offset: 6px; text-decoration-color: #9fae90; }
  .text-link:hover { text-decoration-thickness: 2px; }
  .stage { display: flex; align-items: flex-start; gap: 9px; max-width: 390px; margin-top: 23px; color: #5d655b; font-size: 13px; line-height: 1.7; }
  .status-dot { width: 6px; height: 6px; margin-top: 7px; border-radius: 50%; background: #768853; flex-shrink: 0; }
  .hero-visual { position: relative; min-width: 0; margin-left: 20px; }
  .landscape { position: relative; height: 552px; overflow: hidden; border-radius: 110px 10px 10px 10px; background: #d9ded3; }
  .landscape img { width: 100%; height: 100%; object-fit: cover; object-position: 53% 53%; }
  .landscape::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 30 20 / .25), transparent 35%, transparent 70%, rgb(10 30 20 / .55)); }
  .landscape figcaption { position: absolute; top: 40px; right: 24px; max-width: 170px; z-index: 1; color: #fff; font-size: 14px; line-height: 1.6; text-align: right; text-shadow: 0 1px 6px #15251b; }
  .hero-phone { position: absolute; left: -36px; bottom: -31px; width: 196px; transform: rotate(-7deg); }
  .phone { display: block; background: #202724; border: 1px solid #687069; padding: 6px; border-radius: 24px; box-shadow: 5px 19px 38px rgb(13 30 20 / .22); cursor: zoom-in; }
  .phone img { width: 100%; border-radius: 18px; }
  .hero-phone figcaption { text-align: center; font-size: 12px; line-height: 1.5; color: #5d655b; margin-top: 10px; }
  .photo-index { position: absolute; right: 0; bottom: -27px; font-size: 9px; letter-spacing: 2px; color: #6d7865; }
  .promise-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid #dadfd2; padding-block: 29px; }
  .promise-strip > div { display: flex; justify-content: center; align-items: center; gap: 17px; border-left: 1px solid #dadfd2; }
  .promise-strip > div:first-child { border-left: 0; justify-content: flex-start; }
  .promise-strip > div:last-child { justify-content: flex-end; }
  .promise-strip svg { width: 31px; height: 31px; color: #6d805a; flex-shrink: 0; }
  .promise-strip strong { display: block; font-size: 17px; font-weight: 650; }
  .promise-strip p span { display: block; margin-top: 5px; font-size: 15px; line-height: 1.5; color: #5d655b; }
  .benefits { display: grid; grid-template-columns: 1fr 1.1fr; gap: 100px; padding-block: 95px; }
  h2 { white-space: pre-line; font-size: clamp(32px, 3.3vw, 46px); line-height: 1.16; letter-spacing: -.045em; font-weight: 620; margin-top: 18px; }
  .benefits-intro > p:not(.eyebrow) { font-size: 17px; color: #5d655b; line-height: 1.75; margin-top: 23px; max-width: 375px; }
  .route-drawing { width: 280px; max-width: 100%; margin-top: 20px; }
  .benefit-list article { display: flex; gap: 22px; border-bottom: 1px solid #dadfd2; padding-block: 25px; }
  .benefit-list article:first-child { padding-top: 0; }
  .benefit-list article:last-child { border-bottom: 0; padding-bottom: 0; }
  .number { color: #5d7054; font-size: 13px; font-weight: 600; padding-top: 5px; }
  h3 { font-size: 22px; font-weight: 600; letter-spacing: -.5px; }
  .benefit-list p { font-size: 16px; color: #5d655b; line-height: 1.75; margin-top: 10px; }
  .benefit-list small { display: block; font-size: 13px; color: #5d655b; margin-top: 8px; }
  .app-section { overflow: hidden; background: #203f31; color: #f7f7ef; }
  .app-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 100px; padding-block: 65px; align-items: center; }
  .app-visual { position: relative; display: grid; justify-items: center; }
  .navigation-phone { position: relative; z-index: 1; width: 270px; transform: rotate(5deg); }
  .app-visual figcaption { position: relative; margin-top: 28px; max-width: 320px; text-align: center; font-size: 13px; line-height: 1.6; color: #d8e3d2; }
  .contour { position: absolute; top: 15%; left: 3%; width: 90%; height: 64%; border: 1px solid #4c6650; border-radius: 48% 62% 37% 63%; transform: rotate(-25deg); }
  .contour-two { transform: rotate(-25deg) scale(1.24); opacity: .6; }
  .contour-three { transform: rotate(-25deg) scale(1.5); opacity: .35; }
  .app-copy { position: relative; z-index: 1; }
  .app-copy .eyebrow { color: #c2d5a0; }
  .app-copy > p:not(.eyebrow) { font-size: 17px; color: #d8e3d2; line-height: 1.8; margin-top: 24px; max-width: 440px; }
  .app-copy ul { list-style: none; padding: 0; margin: 28px 0 32px; }
  .app-copy li { display: flex; gap: 13px; padding-block: 14px; border-bottom: 1px solid #45604b; font-size: 15px; line-height: 1.5; color: #e7edde; }
  .app-copy li span { color: #c2d5a0; }
  .join { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 75px; padding-block: 95px; }
  .join h2 { font-size: clamp(30px, 3vw, 40px); }
  .join-desc { margin-top: 20px; color: #5d655b; font-size: 16px; line-height: 1.75; max-width: 440px; }
  form > label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
  .email-row { display: flex; gap: 8px; }
  input[type="email"] { width: 100%; min-width: 0; border: 1px solid #cbd3c3; background: #fff; border-radius: 7px; padding: 14px; font-size: 16px; color: #203d30; }
  input::placeholder { color: #73796c; }
  .email-row .button { padding-inline: 17px; font-size: 14px; gap: 13px; }
  .consent { display: flex; align-items: flex-start; gap: 9px; margin-top: 17px; font-size: 13px; line-height: 1.7; color: #5d655b; font-weight: 400; }
  .consent input { margin-top: 4px; accent-color: #264c38; flex-shrink: 0; }
  .consent a { text-decoration: underline; text-underline-offset: 2px; }
  .form-note { font-size: 13px; line-height: 1.7; margin-top: 14px; color: #5d655b; }
  .form-feedback { font-size: 14px; line-height: 1.7; margin-top: 15px; padding: 12px; background: #e9eddf; border-radius: 6px; }
  .footer { display: flex; align-items: center; justify-content: space-between; gap: 25px; padding-block: 28px 35px; border-top: 1px solid #dadfd2; }
  .footer .brand { font-size: 24px; }
  .footer p { margin-top: 8px; color: #5d655b; font-size: 13px; line-height: 1.7; }
  @media (min-width: 1500px) { .hero { gap: 70px; } }
  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 56px); }
    .hero { gap: 25px; }
    h1 { font-size: 49px; }
    .hero-desc { font-size: 18px; }
    .landscape { height: 515px; }
    .hero-phone { width: 174px; left: -20px; }
    .hero-actions { gap: 21px; }
    .benefits, .app-grid { gap: 45px; }
    .join { gap: 40px; }
    .email-row { flex-direction: column; }
    .promise-strip > div { gap: 10px; }
    .promise-strip p span { max-width: 190px; line-height: 1.6; }
  }
  @media (max-width: 760px) {
    .wrap { width: calc(100% - 40px); }
    .preview-bar { gap: 3px; flex-direction: column; align-items: center; padding: 8px 12px; font-size: 11px; }
    .header { padding-block: 20px; }
    .brand { font-size: 25px; }
    .brand img { width: 31px; height: 31px; }
    nav { gap: 0; }
    .nav-section { display: none; }
    .button-small { display: none; }
    .hero { grid-template-columns: 1fr; padding-top: 24px; padding-bottom: 61px; gap: 33px; }
    .hero-copy { padding-bottom: 0; }
    .eyebrow { font-size: 11px; letter-spacing: 1.1px; }
    h1 { font-size: clamp(39px, 9.5vw, 66px); max-width: 600px; margin-top: 16px; }
    .hero-desc { margin-top: 19px; max-width: 510px; font-size: 17px; }
    .hero-actions { margin-top: 23px; gap: 21px; }
    .button { font-size: 14px; gap: 16px; padding: 14px 18px; min-height: 49px; }
    .text-link { font-size: 14px; gap: 10px; }
    .stage { max-width: 340px; margin-top: 18px; font-size: 12px; }
    .hero-visual { margin-left: 14px; margin-bottom: 15px; }
    .landscape { height: 430px; border-top-left-radius: 75px; }
    .landscape img { object-position: 50% 60%; }
    .landscape figcaption { top: 27px; right: 21px; font-size: 12px; }
    .hero-phone { width: 160px; left: -15px; bottom: -25px; }
    .hero-phone figcaption { font-size: 11px; }
    .promise-strip { grid-template-columns: 1fr; padding-block: 6px; }
    .promise-strip > div, .promise-strip > div:first-child, .promise-strip > div:last-child { justify-content: flex-start; border-left: 0; padding: 15px 6px; gap: 20px; }
    .promise-strip > div + div { border-top: 1px solid #e2e6da; }
    .promise-strip p span { max-width: none; margin-top: 3px; }
