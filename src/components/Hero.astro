---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative overflow-hidden bg-forest-950 bg-cover bg-center" style="background-image: url('/images/hero-night.jpg');">
  <div class="absolute inset-0 bg-gradient-to-b from-forest-950/70 via-forest-950/60 to-forest-950/80"></div>
  <div class="container-wide relative py-20 sm:py-24 lg:py-32">
    <div class="mx-auto max-w-3xl text-center sm:text-left">
      <span class="badge mb-5 bg-white/15 text-sand-100">{t(lang, 'hero.badge')}</span>
      <h1 class="text-4xl font-extrabold tracking-tight text-sand-50 sm:text-5xl lg:text-6xl">
        {t(lang, 'hero.title')}
      </h1>
      <p class="mt-3 text-xl font-semibold text-sand-100 sm:text-2xl">
        {t(lang, 'hero.subtitle')}
      </p>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-sand-200/90 sm:text-lg sm:mx-0 mx-auto">
        {t(lang, 'hero.description')}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:justify-start">
        <a href="#notify" class="inline-flex items-center justify-center rounded-full bg-sand-200 px-6 py-3 text-base font-semibold text-forest-900 shadow-sm transition hover:bg-sand-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-300">
          {t(lang, 'hero.cta.notify')}
        </a>
        <a href="#features" class="inline-flex items-center justify-center rounded-full border-2 border-sand-200/70 bg-transparent px-6 py-3 text-base font-semibold text-sand-100 transition hover:bg-sand-200/10 hover:border-sand-200">
          {t(lang, 'hero.cta.features')}
        </a>
      </div>

      <div class="mt-10 grid grid-cols-3 gap-3 sm:max-w-md sm:gap-4">
        <div class="rounded-xl border border-sand-200/20 bg-forest-900/40 p-3 text-center backdrop-blur-sm">
          <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.offline')}</div>
          <div class="text-xs text-sand-200/80">{t(lang, 'hero.stats.offlineDesc')}</div>
        </div>
        <div class="rounded-xl border border-sand-200/20 bg-forest-900/40 p-3 text-center backdrop-blur-sm">
          <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.gpx')}</div>
          <div class="text-xs text-sand-200/80">{t(lang, 'hero.stats.gpxDesc')}</div>
        </div>
        <div class="rounded-xl border border-sand-200/20 bg-forest-900/40 p-3 text-center backdrop-blur-sm">
          <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.osm')}</div>
          <div class="text-xs text-sand-200/80">{t(lang, 'hero.stats.osmDesc')}</div>
        </div>
      </div>
    </div>
  </div>
</section>
