---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';

import screen1 from '../assets/screens/screen-1.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="site-section relative isolate overflow-hidden">
  <div class="absolute -right-32 top-1/4 h-96 w-96 rounded-full bg-slate-500/15 blur-3xl"></div>
  <div class="container-wide relative py-16 sm:py-20 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] lg:gap-16">
      <div class="mx-auto max-w-2xl text-center sm:mx-0 sm:text-left">
        <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-slate-700/25 bg-white/35 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-slate-800 backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-slate-600"></span>
          {t(lang, 'hero.badge')}
        </span>
        <h1 class="text-5xl font-bold tracking-tight text-slate-900 dark:text-sand-50 sm:text-6xl lg:text-7xl">
          {t(lang, 'hero.title')}
        </h1>
        <p class="mt-3 text-xl font-semibold text-slate-800 dark:text-sand-100 sm:text-2xl">
          {t(lang, 'hero.subtitle')}
        </p>
        <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-slate-700/90 dark:text-sand-200/90 sm:mx-0 sm:text-lg">
          {t(lang, 'hero.description')}
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:justify-start">
          <a href="#notify" class="inline-flex items-center justify-center gap-2 rounded-full bg-sand-200 px-6 py-3 text-base font-semibold text-forest-900 shadow-lg shadow-forest-950/30 transition hover:bg-sand-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-300">
            {t(lang, 'hero.cta.notify')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
          </a>
          <a href="#features" class="inline-flex items-center justify-center rounded-full border border-slate-700/50 bg-slate-900/10 px-6 py-3 text-base font-semibold text-slate-800 transition hover:border-slate-700 hover:bg-slate-900/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand-300 dark:border-sand-200/70 dark:bg-forest-950/20 dark:text-sand-100 dark:hover:border-sand-200 dark:hover:bg-sand-200/10">
            {t(lang, 'hero.cta.features')}
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-3 sm:max-w-md sm:gap-4">
          <div class="rounded-2xl border border-forest-700/60 bg-forest-900/75 p-3 text-center shadow-lg backdrop-blur-sm">
            <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.offline')}</div>
            <div class="text-xs text-sand-200/85">{t(lang, 'hero.stats.offlineDesc')}</div>
          </div>
          <div class="rounded-2xl border border-forest-700/60 bg-forest-900/75 p-3 text-center shadow-lg backdrop-blur-sm">
            <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.gpx')}</div>
            <div class="text-xs text-sand-200/85">{t(lang, 'hero.stats.gpxDesc')}</div>
          </div>
          <div class="rounded-2xl border border-forest-700/60 bg-forest-900/75 p-3 text-center shadow-lg backdrop-blur-sm">
            <div class="text-lg font-bold text-sand-50">{t(lang, 'hero.stats.osm')}</div>
            <div class="text-xs text-sand-200/85">{t(lang, 'hero.stats.osmDesc')}</div>
          </div>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xs lg:mr-0">
        <div class="absolute inset-x-8 top-12 h-72 rounded-full bg-slate-300/30 blur-3xl"></div>
        <div class="hero-phone relative mx-auto w-56 rounded-[2.25rem] border border-neutral-700/25 bg-neutral-900/70 p-2 shadow-2xl backdrop-blur-sm sm:w-64">
          <div class="overflow-hidden rounded-[1.75rem] bg-sand-50">
            <Image
              src={screen1}
              alt={t(lang, 'screens.alt1')}
              widths={[432, 864]}
              sizes="224px"
              format="webp"
              quality={80}
              class="w-full"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-phone {
    transform: rotate(3deg) scale(1);
    transition: transform 320ms ease-out;
    will-change: transform;
  }

  .hero-phone:hover {
    transform: rotate(3deg) scale(1.15);
    transition-duration: 900ms;
    transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-phone {
      transition: none;
    }
  }
</style>
