---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const privacyHref = `/${lang}/polityka-prywatnosci/`;
const privacyHrefEn = `/${lang}/privacy-policy/`;
const finalPrivacyHref = lang === 'pl' ? privacyHref : privacyHrefEn;
---

<footer id="contact" class="border-t border-forest-100 bg-forest-900 text-sand-100">
  <div class="container-wide py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2">
          <img src="/images/logo.png" alt="Naturide" class="h-10 w-10" width="40" height="40" />
          <span class="text-xl font-bold tracking-tight text-sand-50">Naturide</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-sand-200">
          {t(lang, 'hero.subtitle')}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-sand-300">{t(lang, 'contact.title')}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <span class="block text-xs uppercase tracking-wider text-sand-400">{t(lang, 'contact.email')}</span>
            <a href="mailto:mkwiatek.dev@gmail.com" class="text-sand-100 hover:text-white">mkwiatek.dev@gmail.com</a>
          </li>
          <li>
            <span class="block text-xs uppercase tracking-wider text-sand-400">{t(lang, 'contact.facebook')}</span>
            <a href="https://www.facebook.com/Naturideapp/" target="_blank" rel="noopener noreferrer" class="text-sand-100 hover:text-white">facebook.com/Naturideapp</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-sand-300">Naturide</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={finalPrivacyHref} class="text-sand-100 hover:text-white">{t(lang, 'footer.privacy')}</a></li>
          <li><a href="https://www.facebook.com/Naturideapp/" target="_blank" rel="noopener noreferrer" class="text-sand-100 hover:text-white">Facebook</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-forest-700 pt-6 text-center text-xs text-sand-300">
      {t(lang, 'footer.copyright').replace('{year}', String(year))}
    </div>
  </div>
</footer>
