---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const faqs = [
  { q: 'faq.q1', a: 'faq.a1' },
  { q: 'faq.q2', a: 'faq.a2' },
  { q: 'faq.q3', a: 'faq.a3' },
  { q: 'faq.q4', a: 'faq.a4' },
  { q: 'faq.q5', a: 'faq.a5' },
] as const;
---

<section id="faq" class="bg-sand-50 py-16 sm:py-20 lg:py-24">
  <div class="container-narrow">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-forest-900 sm:text-4xl">
        {t(lang, 'faq.title')}
      </h2>
      <p class="mt-3 text-lg text-forest-800/80">{t(lang, 'faq.subtitle')}</p>
    </div>

    <div class="mt-10 space-y-3">
      {faqs.map((f, i) => (
        <details class="group rounded-2xl border border-forest-100 bg-white p-5 transition open:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <span class="text-base font-semibold text-forest-900 sm:text-lg">
              {t(lang, f.q as any)}
            </span>
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-forest-100 text-forest-700 transition group-open:rotate-45">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-forest-800/80 sm:text-base">
            {t(lang, f.a as any)}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
