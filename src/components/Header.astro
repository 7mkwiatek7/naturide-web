---
import { languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const otherLang = lang === 'pl' ? 'en' : 'pl';
const homeHref = lang === 'pl' ? '/' : '/en/';
const switchHref =
  lang === 'pl'
    ? (Astro.url.pathname === '/' || Astro.url.pathname === '/polityka-prywatnosci/'
        ? (Astro.url.pathname === '/polityka-prywatnosci/' ? '/en/privacy-policy/' : '/en/')
        : '/en/')
    : '/';

// Linki nawigacyjne do sekcji na stronie głównej
const homeWithHash = lang === 'pl' ? '/' : '/en/';
const currentPath = Astro.url.pathname;
const isOnHome = currentPath === homeWithHash || currentPath === homeWithHash.replace(/\/$/, '');
const screensHref = isOnHome ? '#screens' : `${homeWithHash}#screens`;
const featuresHref = isOnHome ? '#features' : `${homeWithHash}#features`;
---

<header class="sticky top-0 z-40 border-b border-forest-100 bg-sand-50/80 backdrop-blur dark:border-forest-800 dark:bg-forest-900/80">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href={homeHref} class="flex items-center gap-2 text-forest-700 hover:text-forest-800 dark:text-sand-100 dark:hover:text-sand-50">
      <img src="/images/logo.png" alt="Naturide" class="h-9 w-9" width="36" height="36" />
      <span class="text-lg font-bold tracking-tight">Naturide</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      <a href={featuresHref} class="text-sm font-medium text-forest-700 hover:text-forest-900 dark:text-sand-100 dark:hover:text-sand-50">{t(lang, 'nav.features')}</a>
      <a href={screensHref} class="text-sm font-medium text-forest-700 hover:text-forest-900 dark:text-sand-100 dark:hover:text-sand-50">{t(lang, 'nav.screens')}</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={switchHref}
        aria-label={`Switch to ${languages[otherLang]}`}
        class="rounded-full border border-forest-200 px-3 py-1 text-xs font-semibold text-forest-700 transition hover:border-forest-400 hover:bg-forest-50"
      >
        {otherLang.toUpperCase()}
      </a>
      <button
        type="button"
        onclick="window.__toggleTheme && window.__toggleTheme()"
        aria-label={t(lang, 'nav.toggleTheme')}
        class="hidden h-9 w-9 items-center justify-center rounded-full border border-forest-200 text-forest-700 transition hover:border-forest-400 hover:bg-forest-50 sm:inline-flex dark:border-forest-700 dark:text-sand-100 dark:hover:bg-forest-800"
      >
        <!-- Ikonka słońca - widoczna tylko w trybie jasnym -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 block dark:hidden">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Ikonka księżyca - widoczna tylko w trybie ciemnym -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 hidden dark:block">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href="#notify" class="hidden btn-primary text-sm sm:inline-flex">{lang === 'pl' ? 'Powiadom mnie' : 'Notify me'}</a>
    </div>
  </div>
</header>
