---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const screens = [
  { src: '/images/screen-1.jpg', altKey: 'screens.alt1' as const },
  { src: '/images/screen-2.jpg', altKey: 'screens.alt2' as const },
  { src: '/images/screen-3.jpg', altKey: 'screens.alt3' as const },
  { src: '/images/screen-4.jpg', altKey: 'screens.alt4' as const },
];
---

<section id="screens" class="bg-gradient-to-b from-sand-50 to-forest-50 py-16 sm:py-20 lg:py-24">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-forest-900 sm:text-4xl">
        {t(lang, 'screens.title')}
      </h2>
      <p class="mt-3 text-lg text-forest-800/80">{t(lang, 'screens.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {screens.map((s) => (
        <figure class="overflow-hidden rounded-3xl border border-forest-100 bg-forest-50 p-2 shadow-sm transition hover:shadow-xl">
          <img
            src={s.src}
            alt={t(lang, s.altKey)}
            class="aspect-[9/24] w-full rounded-2xl object-contain"
            loading="lazy"
            width="540"
            height="1440"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
