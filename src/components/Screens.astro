---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';

import screen1 from '../assets/screens/screen-1.jpg';
import screen2 from '../assets/screens/screen-2.jpg';
import screen3 from '../assets/screens/screen-3.jpg';
import screen4 from '../assets/screens/screen-4.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const screens = [
  { src: screen1, altKey: 'screens.alt1' as const },
  { src: screen2, altKey: 'screens.alt2' as const },
  { src: screen3, altKey: 'screens.alt3' as const },
  { src: screen4, altKey: 'screens.alt4' as const },
];
---

<section id="screens" class="bg-gradient-to-b from-sand-50 to-forest-50 py-16 sm:py-20 lg:py-24 dark:from-forest-950 dark:to-forest-900">
  <div class="container-wide">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-forest-900 dark:text-sand-50 sm:text-4xl">
        {t(lang, 'screens.title')}
      </h2>
      <p class="mt-3 text-lg text-forest-800/80 dark:text-sand-200/80">{t(lang, 'screens.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-6 lg:grid-cols-4">
      {screens.map((s) => (
        <figure class="overflow-hidden rounded-3xl border-2 border-slate-800 bg-slate-800 p-2 shadow-sm transition hover:shadow-xl">
          <Image
            src={s.src}
            alt={t(lang, s.altKey)}
            widths={[432, 864]}
            sizes="(max-width: 640px) 432px, 864px"
            format="webp"
            quality={80}
            class="aspect-[9/20] w-full rounded-2xl object-cover"
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
